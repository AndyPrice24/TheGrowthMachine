---
/*
 * One promise, one primary action, one quieter one. No carousel, no stat bar,
 * no logo wall. Sized to its content, not to the viewport.
 *
 * The title is set one sentence per line, so a three-beat headline reads as
 * three beats rather than wrapping wherever the width happens to fall.
 *
 * With a photo: on desktop it sits to the right and fades into the ink on its
 * left edge, so the headline is set over the dark half of the picture rather
 * than in a box beside it. On a phone it goes above the headline, cropped to
 * the faces, and fades into the ink below. The photo is the first thing a
 * visitor loads, so it is eager and high priority, not lazy.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  label: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /* object-position for the phone crop, so the faces stay in frame */
  focus?: string;
}

const { label, title, image, imageAlt = "", focus = "70% 30%" } = Astro.props;
const lines = title.split(/(?<=\.)\s+/);
---

<section class:list={["hero", "on-ink", { "has-photo": image }]} style={`--focus: ${focus}`}>
  {
    image && (
      <div class="photo">
        <Picture
          src={image}
          alt={imageAlt}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 960, 1280, image.width]}
          sizes="(max-width: 1000px) 100vw, 75vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
  <div class="wrap inner">
    <p class="label">{label}</p>
    <h1 class="display h1">{lines.map((line) => <span>{line}</span>)}</h1>
    <div class="lede"><slot /></div>
    <div class="actions"><slot name="actions" /></div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .inner { position: relative; display: grid; gap: 28px; padding-block: clamp(56px, 9vw, 120px) clamp(64px, 10vw, 132px); }
  .h1 { max-width: 13em; }
  .h1 span { display: block; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 8px; }

  /* desktop: the photo fills the right two thirds, fading into the ink */
  .has-photo .inner { align-content: center; min-height: clamp(560px, 48vw, 760px); }
  .has-photo .inner > * { max-width: min(36rem, 48%); }
  .has-photo .h1 { font-size: clamp(2.4rem, 1rem + 3.4vw, 4.4rem); }
  .has-photo .inner > .h1 { max-width: min(42rem, 58%); }
  .has-photo .lede { max-width: min(30rem, 44%); }
  .photo { position: absolute; inset: 0 0 0 auto; width: 66%; }
  .photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 100% 30%; }
  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--ink) 0%, color-mix(in srgb, var(--ink) 70%, transparent) 22%, transparent 48%),
      linear-gradient(to top, var(--ink) 0%, transparent 22%);
  }

  /* tablet and phone: the photo above the headline. Side by side below about
     1000px, the fade swallows whichever of the two sits on the left. */
  @media (max-width: 1000px) {
    .has-photo .inner { min-height: 0; padding-top: 0; margin-top: -48px; }
    .has-photo .inner > *, .has-photo .inner > .h1 { max-width: none; }
    .has-photo .lede { max-width: 36rem; }
    .photo { position: relative; inset: auto; width: 100%; aspect-ratio: 16 / 9; }
    .photo :global(img) { object-position: var(--focus); }
    .photo::after { background: linear-gradient(to top, var(--ink) 0%, transparent 45%); }
  }
  /* phone: cropped in to the faces */
  @media (max-width: 600px) {
    .photo { aspect-ratio: 5 / 4; }
  }
</style>
