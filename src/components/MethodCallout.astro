---
/*
 * The named method. An opinion, not a process diagram.
 * The name is provisional until Andrew and Tarren refine it.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="method">
  <p class="label">The method</p>
  <p class="display name">{name}</p>
  <p class="text"><slot /></p>
</div>

<style>
  .method {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
    gap: 10px 32px;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .label { grid-row: span 2; }
  .name { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); }
  .text { color: var(--muted); max-width: 38em; }
  @media (max-width: 720px) {
    .method { grid-template-columns: minmax(0, 1fr); }
    .label { grid-row: auto; }
  }
</style>
