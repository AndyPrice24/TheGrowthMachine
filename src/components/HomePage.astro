---
/*
 * The homepage, in three versions (decided 9 October 2026):
 *   /            the shared opening, ending at the choice
 *   /b2b         the same opening, then everything below written for B2B,
 *   /ecommerce   or for ecommerce brands. Outbound emails link straight here.
 *
 * Order, and why:
 *   1 Hero            one promise: without the full-time hire
 *   2 Before you hire recognition first (three symptoms), then why us: an
 *                     agency, a full-time hire and The Growth Machine side by
 *                     side. It explains the promise, so it comes next
 *   3 Both sides      revenue and margin feed profit. Nothing else here
 *   4 The split       ecommerce or B2B. On / the page ends here
 *   5 How we work     the machine, with the words beside it for this audience
 *   6 In and out      fixing what leaks, building what's next
 *   7 Ways to work    how the method is bought
 *   8 Who you get     the two founders; this audience's lead introduced first
 *   9 Qualifier       capacity is limited; say so, then book
 *
 * Sections alternate ink and cream. How we work is ink: Andrew chose the
 * machine on black. Copy is a working draft, refined with Andrew and Tarren.
 */
import Base from "../layouts/Base.astro";
import Hero from "./Hero.astro";
import Section from "./Section.astro";
import Machine from "./Machine.astro";
import MachineRun from "./MachineRun.astro";
import Card from "./Card.astro";
import BioBlock from "./BioBlock.astro";
import Placeholder from "./Placeholder.astro";
import CtaBand from "./CtaBand.astro";
import Button from "./Button.astro";
import heroPhoto from "../assets/hero/andrew-and-tarren.webp";
import { tracks, trackOrder, type TrackId } from "../data/tracks";

interface Props {
  trackId?: TrackId;
}

const track = Astro.props.trackId ? tracks[Astro.props.trackId] : undefined;
const tarrenFirst = track?.leads === "tarren";
const meta = track?.meta ?? {
  title: "Fractional CRO, CMO and GTM Leadership | The Growth Machine",
  description:
    "Fractional CRO, CMO, GTM and ecommerce leadership from people who've founded and run their own businesses. We judge growth by profit, and we do the work.",
};
---

<Base title={meta.title} description={meta.description}>
  <Hero
    label="Fractional CRO · CMO · GTM lead"
    title="More revenue. Better margins. Without the full-time hire."
    image={heroPhoto}
    imageAlt="Andrew and Tarren Price at a desk, working through something on a laptop together."
  >
    <p>
      Growth leaders who've founded and run businesses on our own money, so we judge growth by profit, not activity. We find your next
      revenue and what's leaking, then do the work or lead your team through it.
    </p>
    <Fragment slot="actions">
      <Button href="/call">Book a 30-minute call</Button>
      <a class="link" href={track ? "#how-we-work" : "#your-path"}>See how it works <span aria-hidden="true">→</span></a>
    </Fragment>
  </Hero>

  <Section tone="cream" label="Before you hire" title="Sound familiar?">
    <ol class="symptoms">
      <li>
        <p class="symptom-title display">Growth has stalled, or stopped being predictable.</p>
        <p class="muted">And nobody can say whether it's a revenue problem or a margin problem.</p>
      </li>
      <li>
        <p class="symptom-title display">Every big decision still goes through the founder.</p>
        <p class="muted">So the business only grows as fast as one person's diary.</p>
      </li>
      <li>
        <p class="symptom-title display">You're about to hire a CRO, CMO or GTM lead.</p>
        <p class="muted">Before knowing which seat you actually need filled.</p>
      </li>
    </ol>

    <div class="options">
      <h3 class="display options-title"><span>Not another agency.</span> <span>Not a full-time hire, yet.</span></h3>
      <div class="compare">
        <div class="option">
          <p class="label">An agency</p>
          <p>Does what it's briefed to do. Someone still writes the brief.</p>
        </div>
        <div class="option">
          <p class="label">A full-time hire</p>
          <p>A full salary before you know which seat you need.</p>
        </div>
        <div class="option us on-ink">
          <p class="label">The Growth Machine</p>
          <p>Senior growth leaders who see the whole picture and do the work: across the titles, inside your business, for as long as you need us.</p>
        </div>
      </div>
      <p class="options-close">When you do hire, they inherit something that already works.</p>
    </div>
  </Section>

  <Section
    tone="ink"
    label="Both sides of the number"
    title="More revenue is only good news if more of it stays."
  >
    <div class="reframe">
      <Machine />
      <div class="sides">
        <div class="side">
          <h3 class="display h3">Revenue</h3>
          <p>New ways to earn, better ways to earn, and more from the same effort.</p>
          <ul class="levers"><li>Go-to-market</li><li>Pricing</li><li>Channels</li><li>Retention</li></ul>
        </div>
        <div class="side">
          <h3 class="display h3">Margin</h3>
          <p>Money the business already makes and quietly loses on the way out.</p>
          <ul class="levers"><li>Fees and costs</li><li>Processes</li><li>Team shape</li><li>Wasted spend</li></ul>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="cream" id="your-path" label="Start where you are" title="Which sounds like you?">
    <div class="grid-2">
      {trackOrder.map((id) => {
        const t = tracks[id];
        const state = !track ? undefined : id === track.id ? "chosen" : "other";
        return (
          <Card
            variant="path"
            href={`${t.path}#your-path`}
            kicker={t.card.kicker}
            title={t.card.title}
            cta={state === "chosen" ? "You're here" : state === "other" ? t.card.switchTo : t.card.cta}
            state={state}
          >
            <p>{t.card.text}</p>
          </Card>
        );
      })}
    </div>
  </Section>

  {track && (
    <>
      <Section tone="ink" id="how-we-work" label="How we work" title="Find the leak, then the lever.">
        <p class="lede">
          The same four stages on every engagement, in the same order. The first is the deep dive. The last is making sure what we build keeps
          working, with or without us.
        </p>
        <MachineRun copy={track.machine} />
      </Section>

      <Section tone="cream" id="inward-outward" label="Inwards and outwards" title="You started out facing outwards.">
        <p class="lede">
          Founders build a business looking out: at customers, markets, the next opportunity. Then the business needs
          running, and the view turns inward. We look both ways, so you can face forward again.
        </p>
        <div class="grid-2 io">
          <div class="io-col">
            <p class="label">Looking inward</p>
            <h3 class="display h3">Fixing what leaks.</h3>
            <p>{track.inOut.inward}</p>
          </div>
          <div class="io-col">
            <p class="label">Looking outward</p>
            <h3 class="display h3">Building what's next.</h3>
            <p>{track.inOut.outward}</p>
          </div>
        </div>
        <p class="io-close">Most businesses need some of both. The Machine Check tells you which comes first.</p>
      </Section>

      <Section tone="ink" id="ways-to-work" label="Ways to work with us" title="One way in. Two ways to continue.">
        <p class="lede">
          Every engagement starts with a paid deep dive. What happens next depends on what it finds, and the decision is
          yours.
        </p>
        <div class="grid-3">
          <Card
            variant="engagement"
            kicker="Start here"
            title="The Machine Check"
            principle="Everything ranked by what it costs you."
            href="/how-we-work/machine-check"
            cta="About the Machine Check"
          >
            <p>
              A fixed-fee deep dive into the whole commercial picture. You get a ranked view of what each problem costs
              you, in revenue and in margin, with our reasoning and what to do first.
            </p>
          </Card>
          <Card
            variant="engagement"
            kicker="If the fix is a thing"
            title="The Build"
            principle="It has to still work after we leave."
            href="/how-we-work/build"
            cta="About the Build"
          >
            <p>
              A defined project with a handover: a strategy, a plan, a sales process, a system or an AI tool. We build it
              with your team and leave it running.
            </p>
          </Card>
          <Card
            variant="engagement"
            kicker="If the fix is leadership"
            title="The Growth Office"
            principle="In the business, not on a call."
            href="/how-we-work/growth-office"
            cta="About the Growth Office"
          >
            <p>
              One or both of us in your business part-time, owning the growth agenda and doing the work alongside your
              people. When you are ready to hire permanently, we help you hire and hand over.
            </p>
          </Card>
        </div>
        <div class="bench">
          <p class="label">Specialists</p>
          <p class="muted">
            We are two. When a job needs a discipline we don't have, we bring in a specialist we have worked with, at their
            rate, and you see the number before we commit it. We don't mark up other people's time.
          </p>
        </div>
      </Section>

      <Section tone="cream" label="Who you actually get" title="Two senior operators. No juniors, no handoff.">
        <p class="lede">
          The people you meet are the people doing the work. The problem decides who leads, and most clients get both of
          us.
        </p>
        <div class="grid-2 bios">
          {tarrenFirst ? (
            <>
          <BioBlock
            name="Tarren Price"
            role="Ecommerce and consumer brands"
            pending="Tarren's full bio, portrait and three to five career results"
          >
            <p>
              Ecommerce and FMCG personal care, across Amazon, Shopify and Meta advertising. Builds and reshapes ecommerce
              operations to lift revenue and margin.
            </p>
          </BioBlock>
          <BioBlock
            name="Andrew Price"
            role="Revenue, sales and commercial strategy"
            pending="Andrew's full bio, portrait and three to five career results"
          >
            <p>Multiple-time founder, CEO and chief revenue officer, across B2B and B2C.</p>
          </BioBlock>
            </>
          ) : (
            <>
          <BioBlock
            name="Andrew Price"
            role="Revenue, sales and commercial strategy"
            pending="Andrew's full bio, portrait and three to five career results"
          >
            <p>Multiple-time founder, CEO and chief revenue officer, across B2B and B2C.</p>
          </BioBlock>
          <BioBlock
            name="Tarren Price"
            role="Ecommerce and consumer brands"
            pending="Tarren's full bio, portrait and three to five career results"
          >
            <p>
              Ecommerce and FMCG personal care, across Amazon, Shopify and Meta advertising. Builds and reshapes ecommerce
              operations to lift revenue and margin.
            </p>
          </BioBlock>
            </>
          )}
        </div>
        <div class="record">
          <h3 class="display h3">Before The Growth Machine.</h3>
          <p class="muted">
            What we have done in our own careers, labelled as exactly that. Client results replace this as soon as there
            are results we are allowed to publish.
          </p>
          <Placeholder needs="Career results from Andrew and Tarren, written as problem, action, result, with numbers only where they can be stood behind" />
        </div>
        <p><a class="link" href="/who-we-are">Meet Andrew and Tarren <span aria-hidden="true">→</span></a></p>
      </Section>

    </>
  )}

  <CtaBand
    title="Not sure whether you need a CRO, a CMO or something else? Good. That is where we start."
    href="/call"
    action="Book a 30-minute call"
    tone="ink"
  >
    There are two of us, so we take on a small number of clients at a time. Thirty minutes, no deck: we will ask where
    you are trying to get to and what is in the way.
  </CtaBand>
</Base>

<style>
  .reframe { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .sides { display: grid; gap: 28px; }
  .side { display: grid; gap: 8px; padding-top: 18px; border-top: 1px solid var(--line); }
  .side p { max-width: 32em; }
  .levers { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .levers li { font-size: var(--step-small); color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 3px 12px; }

  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }

  /* Recognition: three symptoms, each under a short torch bar (a graphic,
     so allowed on cream), set large enough to be read before anything else. */
  .symptoms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 40px); }
  .symptoms li { display: grid; gap: 10px; align-content: start; }
  .symptoms li::before { content: ""; width: 36px; height: 4px; background: var(--torch); margin-bottom: 6px; }
  .symptom-title { font-size: clamp(1.3rem, 1.05rem + 1vw, 1.75rem); line-height: 1.1; }

  /* Why us: the three options side by side, ours set in ink so it is seen
     before it is read. */
  .options { display: grid; gap: clamp(20px, 3vw, 32px); padding-top: clamp(40px, 6vw, 72px); border-top: 1px solid var(--line); }
  .options-title { font-size: var(--step-h2); }
  .options-title span { display: inline-block; }
  .compare { display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 12px; }
  .option { display: grid; gap: 10px; align-content: start; padding: clamp(20px, 2.4vw, 28px); border: 1px solid var(--line); border-radius: var(--radius); }
  .option .label { color: var(--muted); }
  .option:not(.us) p:last-child { color: var(--muted); }
  .us { border-color: var(--ink); }
  .us .label { color: var(--torch); }
  .us p:last-child { font-size: var(--step-lede); line-height: 1.45; }
  .options-close { font-size: var(--step-lede); font-weight: 600; }

  .bench { display: grid; grid-template-columns: minmax(0, 200px) minmax(0, 1fr); gap: 10px 32px; align-items: baseline; border-top: 1px solid var(--line); padding-top: 24px; }
  .bench .muted { max-width: 44em; }

  .io { gap: clamp(28px, 4vw, 56px); }
  .io-col { display: grid; gap: 10px; align-content: start; padding-top: 20px; border-top: 1px solid var(--line); }
  .io-col p:last-child { max-width: 32em; }
  .io-close { font-size: var(--step-lede); font-weight: 600; }

  .bios { gap: 40px; }
  .record { display: grid; gap: 14px; border-top: 1px solid var(--line); padding-top: 28px; }
  .record .muted { max-width: 40em; }

  @media (max-width: 900px) {
    .grid-3 { grid-template-columns: minmax(0, 1fr); }
  }
  /* below desktop: the two alternatives share a row, ours spans beneath */
  @media (max-width: 900px) {
    .compare { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .us { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .reframe, .grid-2, .bench { grid-template-columns: minmax(0, 1fr); }
    .symptoms { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .symptoms li { gap: 6px; }
    .symptoms li::before { margin-bottom: 4px; }
    .compare { gap: 8px; }
    .option { padding: 14px 16px; gap: 6px; }
    .option .label { letter-spacing: 0.22em; }
  }
</style>
