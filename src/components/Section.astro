---
/*
 * A full-bleed band. Sections alternate ink and cream down the page; that
 * rhythm is the layout's structure, so every section declares its tone.
 */
interface Props {
  tone: "ink" | "cream";
  id?: string;
  label?: string;
  title?: string;
  /* set the title one sentence per line, for a heading built in beats */
  split?: boolean;
}

const { tone, id, label, title, split } = Astro.props;
const lines = title && split ? title.split(/(?<=\.)\s+/) : undefined;
---

<section class:list={["section", `on-${tone}`]} id={id}>
  <div class="wrap inner">
    {(label || title) && (
      <header class="head">
        {label && <p class="label">{label}</p>}
        {title && <h2 class="display h2">{lines ? lines.map((l) => <span class="line">{l}</span>) : title}</h2>}
      </header>
    )}
    <slot />
  </div>
</section>

<style>
  .section { padding-block: var(--section-pad); }
  .line { display: block; }
  .inner { display: grid; gap: clamp(28px, 4vw, 48px); }
  .head { display: grid; gap: 20px; max-width: 900px; }
</style>
