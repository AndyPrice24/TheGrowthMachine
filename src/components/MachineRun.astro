---
/*
 * The machine: Andrew's render of the method, run by the reader's scroll.
 *
 * The render is cut out of its studio backdrop, so the machine and its rubble
 * sit directly on the page. As the reader scrolls, the machine fades back and
 * one phase at a time comes forward, backlit in torch red: every slab and
 * piece of rubble going in, then each stage panel. Live text beside it says
 * what that phase does.
 *
 * What comes out is a short sequence rather than a single light: the chart's
 * arrow climbs, each bar lights as the arrow passes it, and each result block
 * lights with its bar (bottom up on desktop, left to right on a phone), the
 * last with the arrow's tip. Everything then stays lit. The page holds at the
 * end of the section until the sequence has played once, so nobody scrolls
 * past it half-finished; it is never held with reduced motion.
 *
 * The nameplate is redrawn in vector over the render, with the real logo,
 * because the render's own lettering was an AI approximation of it. It is a
 * lightbox: lit warm from the first moment the machine is seen, and never
 * faded with the rest of the machine. Its gear turns as the machine runs.
 *
 * The render pins in place and the scroll drives the sequence. Desktop shows
 * the landscape render with the steps beside it; a phone shows the portrait
 * render, sized to fit the screen, with the current step beneath it.
 * Reduced motion or no JavaScript: no pinning, no fading, every step listed.
 *
 * Every image in src/assets/machine/ is made from Andrew's originals in
 * brand/machine/ by brand/tools/cutout-machine.py and machine-glows.py, which
 * also writes manifest.json: the canvas size, its padding, and where and when
 * each piece of the result sequence appears. The build turns the images into
 * AVIF and WebP with transparency, loaded lazily.
 */
import { getImage } from "astro:assets";
import desktopSrc from "../assets/machine/machine-desktop.png";
import mobileSrc from "../assets/machine/machine-mobile.png";
import manifest from "../assets/machine/manifest.json";
import { LOGO_VIEWBOX, GEAR_CENTRE } from "./logo-paths";

type Kind = "desktop" | "mobile";
type Box = number[];

const pngs = import.meta.glob<{ default: ImageMetadata }>("../assets/machine/*.png", { eager: true });
const png = (name: string) => pngs[`../assets/machine/${name}.png`].default;

/** Seconds for the arrow to climb from its tail to its tip. */
const SEQ_SECONDS = 2.4;
/** Seconds each bar or block takes to come on. Matches the light-on animation. */
const LIGHT_ON_SECONDS = 0.35;

// Positions below are in the original render's pixels; the manifest's offset
// maps them onto the padded canvas.
const art = {
  desktop: {
    src: desktopSrc,
    widths: [960, manifest.desktop.size[0]],
    sizes: "(min-width: 761px) 75vw, 100vw",
    plate: { x: 545, y: 515, w: 364, h: 143, r: 7 },
    logo: { cx: 727.5, cy: 586.5, w: 267 },
    rivets: [[559, 532], [895, 532], [559, 642], [895, 642]],
    rivet: 7,
    halo: 16,
    floor: { y: 952, x0: 30, x1: 1440 },
  },
  mobile: {
    src: mobileSrc,
    widths: [640, manifest.mobile.size[0]],
    sizes: "100vw",
    plate: { x: 272, y: 652, w: 390, h: 158, r: 8 },
    logo: { cx: 475.5, cy: 732.5, w: 281 },
    rivets: [[302, 674], [646, 674], [302, 796], [646, 796]],
    rivet: 8,
    halo: 18,
    floor: { y: 1588, x0: 50, x1: 890 },
  },
};

const formats = async (src: ImageMetadata, widths?: number[]) => ({
  avif: await getImage({ src, format: "avif", widths }),
  webp: await getImage({ src, format: "webp", widths }),
});

const PHASES = ["in", "s1", "s2", "s3", "s4"] as const;

async function build(kind: Kind) {
  const m = manifest[kind];
  const [W, H] = m.size;
  const pct = ([x, y, w, h]: Box) =>
    `left: ${((x / W) * 100).toFixed(3)}%; top: ${((y / H) * 100).toFixed(3)}%; width: ${((w / W) * 100).toFixed(3)}%; height: ${((h / H) * 100).toFixed(3)}%`;
  const { box, span } = m.seq.arrow;
  // The wipe runs past the arrow's tip to uncover the glow beyond it, at the same speed.
  const tail = ((span[0] - box[0]) / box[2]) * 100;
  const arrowSeconds = (SEQ_SECONDS * (box[0] + box[2] - span[0])) / (span[1] - span[0]);
  const lastItem = Math.max(...m.seq.items.map((it) => it.at)) * SEQ_SECONDS + LIGHT_ON_SECONDS;
  return {
    seqMs: Math.round(Math.max(arrowSeconds, lastItem) * 1000),
    W,
    H,
    ox: m.offset[0],
    oy: m.offset[1],
    base: await formats(art[kind].src, art[kind].widths),
    glows: await Promise.all(PHASES.map(async (phase) => ({ phase, ...(await formats(png(`glow-${kind}-${phase}`), art[kind].widths)) }))),
    arrow: {
      ...(await formats(png(`seq-${kind}-arrow`))),
      style: `${pct(box)}; --wipe-from: ${(100 - tail).toFixed(2)}%; --wipe-time: ${arrowSeconds.toFixed(2)}s`,
    },
    items: await Promise.all(
      m.seq.items.map(async (it) => ({
        ...(await formats(png(`seq-${kind}-${it.name}`))),
        style: `${pct(it.box)}; --at: ${(it.at * SEQ_SECONDS).toFixed(2)}s`,
      })),
    ),
  };
}
const built = { desktop: await build("desktop"), mobile: await build("mobile") };

const steps = [
  { id: "in", k: "In", name: "What comes in", text: "Stalled growth, an unclear go-to-market, weak acquisition, low conversion, margin leakage, founder dependency. Most businesses arrive with two or three." },
  { id: "s1", k: "01", name: "Diagnose", text: "Find the real constraints. The deep dive ranks every problem by what it costs you, in revenue and in margin." },
  { id: "s2", k: "02", name: "Design", text: "Build the growth system: a few priorities, each with an owner, a number and a place in the order." },
  { id: "s3", k: "03", name: "Execute", text: "Implement and optimise, alongside your people. The work gets done in the business, not described in a deck." },
  { id: "s4", k: "04", name: "Embed", text: "Make it stick in the business, so it keeps running when we step back." },
  { id: "out", k: "Out", name: "What comes out", text: "More revenue and better margins, with the systems and the team to keep it going." },
];

const LOGO_ASPECT = 528 / 1409;
const ALT =
  "The Growth Machine drawn as a machine. Problems go in at one end: stalled growth, unclear go-to-market, weak acquisition, low conversion, margin leakage and founder dependency. They pass through four stages, diagnose, design, execute and embed, and come out as more revenue, better margins, better systems, a stronger team and scalable growth.";
---

<div class="machine-run" data-machine-run>
  <div class="pin">
    {(["desktop", "mobile"] as const).map((kind) => {
      const a = art[kind];
      const b = built[kind];
      const { W, H, ox, oy } = b;
      const lw = a.logo.w;
      const lh = lw * LOGO_ASPECT;
      const floorX = ((a.floor.x0 + a.floor.x1) / 2 + ox) / W;
      return (
        <figure
          class:list={["frame", `frame--${kind}`]}
          data-seq-ms={b.seqMs}
          style={`aspect-ratio: ${W} / ${H}; --ar: ${(W / H).toFixed(4)}; --floor-y: ${(((a.floor.y + oy) / H) * 100).toFixed(2)}%; --floor-x: ${(floorX * 100).toFixed(2)}%; --floor-w: ${(((a.floor.x1 - a.floor.x0) / W) * 100).toFixed(2)}%`}
        >
          <div class="floor" aria-hidden="true"></div>
          <picture class="layer base">
            <source type="image/avif" srcset={b.base.avif.srcSet.attribute} sizes={a.sizes} />
            <source type="image/webp" srcset={b.base.webp.srcSet.attribute} sizes={a.sizes} />
            <img src={b.base.webp.src} width={W} height={H} loading="lazy" decoding="async" alt={ALT} />
          </picture>

          {b.glows.map((g) => (
            <picture class="layer glow" data-phase={g.phase} aria-hidden="true">
              <source type="image/avif" srcset={g.avif.srcSet.attribute} sizes={a.sizes} />
              <source type="image/webp" srcset={g.webp.srcSet.attribute} sizes={a.sizes} />
              <img src={g.webp.src} width={W} height={H} loading="lazy" decoding="async" alt="" />
            </picture>
          ))}

          <div class="seq" aria-hidden="true">
            <picture class="seq-arrow" style={b.arrow.style}>
              <source type="image/avif" srcset={b.arrow.avif.src} />
              <img src={b.arrow.webp.src} loading="lazy" decoding="async" alt="" />
            </picture>
            {b.items.map((it) => (
              <picture class="seq-item" style={it.style}>
                <source type="image/avif" srcset={it.avif.src} />
                <img src={it.webp.src} loading="lazy" decoding="async" alt="" />
              </picture>
            ))}
          </div>

          <svg class="layer lightbox" viewBox={`${-ox} ${-oy} ${W} ${H}`} aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id={`face-${kind}`} cx="50%" cy="48%" r="72%">
                <stop offset="0" style="stop-color: var(--lightbox-hi)" />
                <stop offset="0.55" style="stop-color: var(--lightbox-mid)" />
                <stop offset="1" style="stop-color: var(--lightbox-lo)" />
              </radialGradient>
              <radialGradient id={`rivet-${kind}`} cx="35%" cy="35%" r="70%">
                <stop offset="0" style="stop-color: var(--rivet-hi)" />
                <stop offset="1" style="stop-color: var(--rivet-lo)" />
              </radialGradient>
              <filter id={`halo-${kind}`} x="-40%" y="-80%" width="180%" height="260%">
                <feGaussianBlur stdDeviation={a.halo} />
              </filter>
            </defs>
            <rect class="halo" x={a.plate.x - 4} y={a.plate.y - 4} width={a.plate.w + 8} height={a.plate.h + 8} rx={a.plate.r + 4} filter={`url(#halo-${kind})`} />
            <rect class="plate" x={a.plate.x} y={a.plate.y} width={a.plate.w} height={a.plate.h} rx={a.plate.r} fill={`url(#face-${kind})`} />
            <rect class="diffuser" x={a.plate.x + 5} y={a.plate.y + 5} width={a.plate.w - 10} height={a.plate.h - 10} rx={Math.max(2, a.plate.r - 3)} />
            {a.rivets.map(([x, y]) => <circle cx={x} cy={y} r={a.rivet} fill={`url(#rivet-${kind})`} class="rivet" />)}
            <svg x={a.logo.cx - lw / 2} y={a.logo.cy - lh / 2} width={lw} height={lh} viewBox={LOGO_VIEWBOX} overflow="visible">
              <use href="#tgm-wordmark" class="plate-word"></use>
              <g transform={`translate(${GEAR_CENTRE.x} ${GEAR_CENTRE.y})`}>
                <use href="#tgm-gear" class="plate-gear"></use>
              </g>
            </svg>
          </svg>
        </figure>
      );
    })}

    <ol class="steps">
      {steps.map((s, i) => (
        <li class:list={["step", { "is-active": i === 0 }]} data-step={s.id}>
          <span class="k">{s.k}</span>
          <h3 class="name display">{s.name}</h3>
          <p class="text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const phone = window.matchMedia("(max-width: 760px)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-machine-run]")) {
    const stepEls = [...root.querySelectorAll<HTMLElement>(".step")];
    const frames = [...root.querySelectorAll<HTMLElement>(".frame")];
    const order = stepEls.map((s) => s.dataset.step!);
    let queued = false;
    let current = -1;

    // Holding the page at the end of the section until what comes out has
    // played once. Armed only by arriving from above, so a reload further
    // down the page is never pulled back up.
    let armed = false;
    let played = false;
    let holdY: number | null = null;
    let holdTimer = 0;

    const endOfSection = () => root.getBoundingClientRect().top + window.scrollY + root.offsetHeight - (window.innerHeight || 800);

    function hold() {
      if (!armed || played || holdY !== null) return;
      holdY = Math.round(endOfSection());
      const ms = Number(frame().dataset.seqMs || 3000) + 150;
      holdTimer = window.setTimeout(release, ms);
      if (window.scrollY > holdY) window.scrollTo(0, holdY);
    }

    function release() {
      window.clearTimeout(holdTimer);
      if (holdY !== null) played = true;
      holdY = null;
    }

    const blocked = (down: boolean) => holdY !== null && down && window.scrollY >= holdY - 1;
    window.addEventListener("wheel", (e) => blocked(e.deltaY > 0) && e.preventDefault(), { passive: false });
    let touchY = 0;
    window.addEventListener("touchstart", (e) => (touchY = e.touches[0].clientY), { passive: true });
    window.addEventListener("touchmove", (e) => blocked(touchY - e.touches[0].clientY > 0) && e.preventDefault(), { passive: false });
    window.addEventListener("keydown", (e) => {
      const down = ["ArrowDown", "PageDown", "End", " ", "Spacebar"].includes(e.key) && !e.shiftKey;
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      if (blocked(down)) e.preventDefault();
    });

    const frame = () => root.querySelector<HTMLElement>(phone.matches ? ".frame--mobile" : ".frame--desktop")!;

    function activate(i: number) {
      if (i === current) return;
      current = i;
      const id = order[i];
      stepEls.forEach((s, j) => s.classList.toggle("is-active", j === i));
      for (const f of frames) {
        f.querySelectorAll<HTMLElement>(".glow").forEach((g) => g.classList.toggle("is-on", g.dataset.phase === id));
        // Re-entering what comes out replays its sequence from the start.
        f.classList.toggle("is-running", id === "out");
      }
      if (id === "out") hold();
      else armed = true;
    }

    function update() {
      queued = false;
      const vh = window.innerHeight || 800;
      // The render is pinned: the scroll through the section drives the sequence.
      const r = root.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, -r.top / Math.max(1, r.height - vh)));
      const i = Math.min(order.length - 1, Math.floor(p * order.length));
      activate(i);
      // a scrollbar drag or a fling can still get past: put it back
      if (holdY !== null && window.scrollY > holdY + 1) window.scrollTo(0, holdY);
      const turn = `rotate(${(p * 720).toFixed(1)}deg)`;
      frame().querySelectorAll<SVGElement>(".plate-gear").forEach((g) => (g.style.transform = turn));
    }

    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    function start() {
      const live = !reduce.matches;
      root.classList.toggle("is-live", live);
      current = -1;
      release();
      if (live) {
        update();
      } else {
        stepEls.forEach((s) => s.classList.remove("is-active"));
        frames.forEach((f) => f.classList.remove("is-running"));
      }
    }

    window.addEventListener("scroll", () => root.classList.contains("is-live") && queue(), { passive: true });
    window.addEventListener("resize", () => root.classList.contains("is-live") && queue());
    reduce.addEventListener("change", start);
    phone.addEventListener("change", start);
    start();
  }
</script>

<style>
  .machine-run { position: relative; }
  .pin { display: grid; gap: 28px; }

  .frame { position: relative; margin: 0; width: 100%; }
  .layer { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .layer img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .glow { display: none; opacity: 0; transition: opacity 0.45s var(--ease-out); }
  /* a soft contact shadow, so the machine stands on the page rather than floating */
  .floor {
    position: absolute;
    left: calc(var(--floor-x) - var(--floor-w) / 2);
    width: var(--floor-w);
    top: calc(var(--floor-y) - 2.5%);
    height: 5%;
    background: radial-gradient(closest-side, var(--shade), transparent);
    opacity: 0.55;
  }

  /* ---- the lightbox nameplate: always lit, never faded ---- */
  .lightbox { pointer-events: none; overflow: visible; }
  .halo { fill: var(--lightbox-glow); opacity: 0.7; }
  .plate { stroke: var(--lightbox-edge); stroke-width: 1.5; }
  .diffuser { fill: none; stroke: var(--lightbox-hi); stroke-width: 3; opacity: 0.6; }
  .rivet { stroke: var(--rivet-lo); stroke-width: 1; }
  .plate-word { fill: var(--ink); }
  .plate-gear { fill: var(--torch); }

  /* ---- what comes out: arrow climbs, bars and blocks light in step ---- */
  .seq { position: absolute; inset: 0; display: none; pointer-events: none; }
  .seq picture { position: absolute; display: block; }
  .seq img { display: block; width: 100%; height: 100%; }
  .seq-item { opacity: 0; }
  .seq-arrow { clip-path: inset(0 100% 0 0); }
  /* 0.35s is LIGHT_ON_SECONDS above */
  .is-running .seq-item { animation: light-on 0.35s var(--ease-out) var(--at) both; }
  .is-running .seq-arrow { animation: climb var(--wipe-time) linear both; }
  @keyframes light-on {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes climb {
    from { clip-path: inset(0 var(--wipe-from) 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  .frame--mobile { display: none; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .step { display: grid; gap: 6px; }
  .k { font-family: var(--f-label); font-size: var(--step-label); letter-spacing: 0.2em; text-transform: uppercase; color: var(--torch); }
  .name { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem); }
  .text { color: var(--muted); max-width: 30em; }

  /* ---- live: the render pins and the scroll runs it ---- */
  .is-live { height: calc(100vh + 6 * 45vh); }
  .is-live .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    align-content: center;
    padding-block: 20px;
  }
  .is-live .step { transition: opacity 0.4s var(--ease-out); }

  @media (min-width: 761px) {
    /* The machine is the centrepiece: let it run wider than the text column. */
    .machine-run { margin-inline: calc((100% - min(100vw - 2 * var(--gutter), 1400px)) / 2); }
    .is-live .pin { grid-template-columns: minmax(0, 1fr) minmax(240px, 280px); align-items: center; gap: clamp(24px, 3vw, 48px); }
    .is-live .frame--desktop { width: min(100%, calc((100svh - 40px) * var(--ar))); justify-self: center; }
    .is-live .step { opacity: 0.38; }
    .is-live .step .text { display: none; }
    .is-live .step.is-active { opacity: 1; }
    .is-live .step.is-active .text { display: block; }
    .is-live .step:not(.is-active) .k { color: var(--muted); }
  }

  @media (max-width: 760px) {
    .frame--desktop { display: none; }
    .frame--mobile { display: block; }
    .is-live .pin { gap: 14px; justify-items: center; align-content: start; padding-top: 16px; }
    .is-live .frame--mobile { width: min(100%, calc((100svh - 190px) * var(--ar))); }
    .is-live .steps { min-height: 130px; align-content: start; width: 100%; }
    .is-live .step:not(.is-active) { display: none; }
  }

  /* live: the machine fades back, the active phase comes forward backlit */
  .is-live .base { opacity: 0.6; filter: grayscale(0.35); transition: opacity 0.4s var(--ease-out); }
  .is-live .glow { display: block; }
  .is-live .glow.is-on { opacity: 1; }
  .is-live .seq { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .glow { transition: none; }
  }
</style>
