---
/*
 * Site header. Desktop: logo, nav, one call to action. Phone: logo, the call
 * to action, and a menu button that opens the nav. The menu is keyboard
 * operable and closes on Escape. Without JavaScript the nav simply shows.
 */
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const nav = [
  { href: "/how-we-work", label: "How we work" },
  { href: "/who-we-are", label: "Who we are" },
  { href: "/before-you-hire", label: "Before you hire" },
];
const path = Astro.url.pathname;
---

<header class="site-head on-cream" data-menu="closed">
  <div class="wrap bar">
    <a class="home" href="/" aria-label="The Growth Machine, home">
      <Logo width={200} spin decorative />
    </a>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <Button href="/call" size="sm">Book a call</Button>
      <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="visually-hidden">Menu</span>
        <span class="bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const head = document.querySelector<HTMLElement>(".site-head");
  const btn = head?.querySelector<HTMLButtonElement>(".menu");
  if (head && btn) {
    const set = (open: boolean) => {
      head.dataset.menu = open ? "open" : "closed";
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", () => set(head.dataset.menu !== "open"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && head.dataset.menu === "open") {
        set(false);
        btn.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (head.dataset.menu === "open" && !head.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  .site-head { position: relative; z-index: 5; }
  .bar { display: flex; align-items: center; gap: 28px; padding-block: 22px; }
  .home { display: block; color: var(--fg); flex: none; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
  .nav a { text-decoration: none; font-weight: 500; font-size: 0.95rem; }
  .nav a:hover, .nav a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 5px; }
  .actions { display: flex; align-items: center; gap: 12px; }
  .menu {
    display: none;
    width: 42px; height: 42px; padding: 0;
    background: transparent; color: var(--fg);
    border: 1px solid var(--line); border-radius: var(--radius);
    align-items: center; justify-content: center; cursor: pointer;
  }
  .bars { display: grid; gap: 6px; }
  .bars span { display: block; width: 18px; height: 2px; background: currentColor; transition: transform 0.2s var(--ease-out); }
  [data-menu="open"] .bars span:first-child { transform: translateY(4px) rotate(45deg); }
  [data-menu="open"] .bars span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 820px) {
    .bar { gap: 12px; padding-block: 16px; flex-wrap: wrap; }
    .home :global(.logo) { width: 156px; height: auto; }
    .actions { margin-left: auto; }
    :global(.js) .menu { display: inline-flex; }
    .nav { order: 3; flex-basis: 100%; margin-left: 0; }
    .nav ul { flex-wrap: wrap; gap: 4px 20px; }
    :global(.js) .nav { display: none; }
    :global(.js) [data-menu="open"] .nav { display: block; border-top: 1px solid var(--line); padding-top: 8px; }
    :global(.js) [data-menu="open"] .nav ul { flex-direction: column; gap: 0; }
    :global(.js) [data-menu="open"] .nav a { display: block; padding-block: 12px; font-size: 1.05rem; }
  }
  /* 360px phones: logo, button and menu must still share one row */
  @media (max-width: 400px) {
    .home :global(.logo) { width: 136px; }
    .actions { gap: 8px; }
  }
</style>
